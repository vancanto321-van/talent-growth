{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "天赋生长",
  "version": "0.1.0",
  "identifier": "com.childgrowth.desktop",
  "build": {
    "frontendDist": "../../talent-growth/app/www",
    "devUrl": "http://127.0.0.1:4184/growth/",
    "beforeBuildCommand": "node ../../talent-growth/app/scripts/sync-data.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "天赋生长",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
