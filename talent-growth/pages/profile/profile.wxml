<view class="page">
  <!-- 等级卡 -->
  <view class="hero">
    <text class="lv-emoji">{{level.emoji}}</text>
    <view class="lv-title">{{level.title}}</view>
    <view class="lv-num">Lv.{{level.level}} · 经验 {{level.xp}}</view>
    <view class="xp-bar"><view class="xp-fill" style="width:{{level.percent}}%"></view></view>
    <view class="muted xp-hint">{{level.percent}}% · 距「{{level.nextTitle}}」还差 {{level.nextNeed}} 经验</view>
  </view>

  <!-- 宝宝切换 -->
  <view class="card">
    <view class="row-between">
      <view class="section-h" style="margin:0">我的宝宝（{{babies.length}}）</view>
      <text class="baby-add" bindtap="addBaby">＋ 添加宝宝</text>
    </view>
    <view wx:if="{{!babies.length}}" class="empty">还没有宝宝，点右上角添加 👶</view>
    <view wx:if="{{babies.length}}" class="baby-row">
      <view wx:for="{{babies}}" wx:key="id" class="baby-chip {{activeBaby && activeBaby.id===item.id?'on':''}}" data-id="{{item.id}}" bindtap="switchBaby">
        <text class="baby-emoji">{{item.gender==='女'?'👧':'👦'}}</text>
        <text class="baby-name">{{item.name}}</text>
        <text wx:if="{{activeBaby && activeBaby.id===item.id}}" class="baby-cur">✓</text>
      </view>
    </view>
    <text wx:if="{{babies.length > 1}}" class="baby-del" bindtap="removeBaby">删除当前宝宝</text>
  </view>

  <!-- 档案 -->
  <view class="card">
    <view class="section-h">宝贝档案</view>
    <view class="form-row">
      <text class="lbl">昵称</text>
      <input class="inp" placeholder="宝贝的小名" value="{{child.name}}" bindinput="onName" />
    </view>
    <view class="form-row">
      <text class="lbl">生日</text>
      <picker mode="date" value="{{child.birthday}}" end="2030-12-31" bindchange="onBirthday">
        <view class="inp {{child.birthday?'':'ph'}}">{{child.birthday || '选择生日'}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="lbl">性别</text>
      <view class="row" style="gap:16rpx">
        <text class="sex {{child.gender==='男'?'on':''}}" data-g="男" bindtap="pickGender">👦 男</text>
        <text class="sex {{child.gender==='女'?'on':''}}" data-g="女" bindtap="pickGender">👧 女</text>
      </view>
    </view>
    <button class="btn-primary" bindtap="save" style="margin-top:20rpx">保存档案</button>
  </view>

  <!-- 闯关进度 -->
  <view class="card">
    <view class="section-h">闯关进度</view>
    <view wx:for="{{unlockedBands}}" wx:key="key" class="ub-item" data-key="{{item.key}}" bindtap="goBand">
      <text class="ub-emoji">🔓</text>
      <view class="col" style="flex:1">
        <text class="ub-title">{{item.label}} · {{item.stage}}</text>
        <text class="muted">第 {{item.order + 1}} 关 · {{item.count}} 项里程碑</text>
      </view>
      <text class="ub-arrow">›</text>
    </view>
  </view>

  <!-- 徽章 -->
  <view class="card">
    <view class="section-h">获得徽章（{{allBadges.length}}）</view>
    <view wx:if="{{!allBadges.length}}" class="empty">完成某个领域全部里程碑达标即可获得徽章 🏅</view>
    <view class="badges">
      <view wx:for="{{allBadges}}" wx:key="name" class="badge-item">
        <text class="badge-emoji">🏅</text>
        <text class="badge-name">{{item.name}}</text>
        <text class="badge-band muted">{{item.band}}</text>
      </view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="row stats" style="position:relative">
    <view class="stat"><text class="stat-num">{{stats.records}}</text><text class="stat-label">成长记录</text></view>
    <view class="stat"><text class="stat-num">{{stats.achieved}}</text><text class="stat-label">已达标</text></view>
    <view class="stat"><text class="stat-num">{{stats.observed}}</text><text class="stat-label">已观察</text></view>
    <view class="stats-link" bindtap="goStats">📊 成长统计 ›</view>
  </view>

  <view class="card about">
    <view class="section-h">关于</view>
    <view class="muted">孩子成长 · 0-8 岁发展培养体系小程序</view>
    <view class="muted">覆盖 6 个年龄段、7 大发展领域、434 项里程碑，配套陪伴指南、安全事项与逐年物品清单。</view>
    <view class="muted">里程碑是参考区间，非 KPI；发现明显偏离请以医生评估为准。</view>
    <view class="section-h">数据备份</view>
    <view class="muted">导出后请妥善保存备份文本；恢复会覆盖当前档案、进度和记录。</view>
    <view class="backup-actions row">
      <button class="btn-ghost backup-btn" bindtap="exportData">导出备份</button>
      <button class="btn-ghost backup-btn" bindtap="importData">从剪贴板恢复</button>
    </view>
    <button class="btn-ghost" bindtap="reset" style="margin-top:24rpx">重置全部数据</button>
  </view>
</view>
